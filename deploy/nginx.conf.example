# Rammerhead Stream behind nginx (TLS termination, rate limiting, websockets).
# Replace stream.example.com and the certificate paths. Include this from /etc/nginx/conf.d/ or sites-enabled.
#
# In config.js (or config.js overrides) you must also set:
#   network.trustProxy = ['127.0.0.1']          // so real client IPs are read from X-Forwarded-For
#   getServerInfo = () => ({ hostname: 'stream.example.com', port: 443, crossDomainPort: 8443, protocol: 'https:' })
#   bindingAddress = '127.0.0.1'                 // only nginx can reach the app

limit_req_zone $binary_remote_addr zone=stream_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=stream_general:10m rate=50r/s;
limit_req_status 429;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream stream_main  { server 127.0.0.1:8080; keepalive 32; }
upstream stream_cross { server 127.0.0.1:8081; keepalive 32; }

server {
    listen 80;
    server_name stream.example.com;
    return 301 https://$host$request_uri;
}

# main port (443) and cross-domain port (8443) share one configuration through the include below
server {
    listen 443 ssl http2;
    server_name stream.example.com;
    server_tokens off;

    ssl_certificate     /etc/ssl/certs/stream.example.com.pem;
    ssl_certificate_key /etc/ssl/private/stream.example.com.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 50m;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    # sign-in and sign-up: slow down guessing at the edge as well as in the app
    location ~ ^/api/auth/ {
        limit_req zone=stream_auth burst=10 nodelay;
        proxy_pass http://stream_main;
        include /etc/nginx/snippets/stream-proxy.conf;
    }

    location / {
        limit_req zone=stream_general burst=200 nodelay;
        proxy_pass http://stream_main;
        include /etc/nginx/snippets/stream-proxy.conf;
    }
}

server {
    listen 8443 ssl http2;
    server_name stream.example.com;
    server_tokens off;
    ssl_certificate     /etc/ssl/certs/stream.example.com.pem;
    ssl_certificate_key /etc/ssl/private/stream.example.com.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 50m;
    proxy_read_timeout 300s;

    location / {
        proxy_pass http://stream_cross;
        include /etc/nginx/snippets/stream-proxy.conf;
    }
}
